# Домен, по которому клиенты приходят на WEB-прокси (и который попадает в ссылки)
HOSTNAME_ARG=proxy.example.com
# Свой Cloudflare Worker (cloudflare/worker.js) и его ключ AUTH.
# Если Worker уже развёрнут (общий с другими серверами) — впишите ЕГО ключ AUTH; пустой ключ сгенерируется,
# и Worker такие запросы не примет (в панели он при этом «доступен», а Telegram не работает).
# Формат строго КЛЮЧ=значение (не «КЛЮЧ: значение»).
CF_WORKER=worker.example.workers.dev
CF_WORKER_AUTH=
# 1 = в Telegram только через Worker (без прямых попыток и чужих CF-доменов)
TGWS_ONLY_WORKER=0
# 1 = к Worker по HTTP/1.1, без HTTP/2: если у провайдера соединения с Worker «зависают»
# (проверка: curl --http1.1 к домену Worker быстрый, а обычный curl висит до таймаута)
TGWS_NO_H2=0
# Порт панели
PANEL_ADDR=0.0.0.0:7655
# Вход WEB-прокси настраивается в панели (карточка WEB → «Порты входа»), без пересоздания контейнера.
# Здесь — только начальные значения для первого запуска: HTTP для NPM/Caddy и, по желанию, прямой HTTPS.
FRONT_ADDR=127.0.0.1:19443
FRONT_TLS_ADDR=
# Локальный IP для ссылки SOCKS5 (пусто = определить автоматически)
LOCAL_IP=
# Имя тома с настройками (для перехода со старой версии: tproxy-web_config_data)
CONFIG_VOLUME=tproxy-web_config
