# Шаблон для официального образа nginx: ${NPM_IP} подставляется из окружения,
# переменные nginx ($host и т. п.) не трогаются.

# --- Вход от главного NPM -------------------------------------------------
geo $from_npm {
    default    0;
    ${NPM_IP}  1;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/gateway.crt;
    ssl_certificate_key /etc/nginx/certs/gateway.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Всем, кроме главного NPM, — молча рвём соединение.
    if ($from_npm = 0) {
        return 444;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # Главный NPM уже кладёт сюда ровно один адрес клиента — передаём как есть.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        set $tp_connection "";
        if ($http_upgrade) {
            set $tp_connection "upgrade";
        }
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tp_connection;

        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 4m;
        access_log off;
    }
}

# --- Сайт-прикрытие (public_upstream relay) --------------------------------
server {
    listen 127.0.0.1:13000;
    server_name _;
    server_tokens off;

    # ВАРИАНТ 1: статичный сайт из ./site/html (index.html + 404.html)
    root /usr/share/nginx/html;
    index index.html;
    error_page 404 /404.html;
    location / {
        try_files $uri $uri/ =404;
    }

    # ВАРИАНТ 2: прикрытие = настоящий сайт/веб-почта, который уже живёт на этом
    # хосте (mail.example.ru). Указывайте ИСТОЧНИК (куда главный NPM шлёт сайт),
    # а НЕ публичный https://mail.example.ru — иначе запросы под префиксом
    # уйдут обратно в NPM → в relay → по кругу.
    #
    # Пример для веб-почты на https://192.168.0.9:443 (её origin в локальной сети):
    #
    # location / {
    #     proxy_pass https://192.168.0.9:443;     # origin веб-почты
    #     proxy_ssl_verify off;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto https;
    # }
}
